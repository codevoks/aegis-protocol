{
  "name": "@aegis/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 9 TypeScript SDK for Aegis Protocol -- typed codegen, PDA/account/read helpers, client-side math, oracle abstraction, and transaction builders. Built on @solana/kit v8.x and @anchor-lang/core; never @coral-xyz/anchor or @solana/web3.js.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "codegen": "node scripts/codegen.mjs",
    "codegen:check": "node scripts/check-codegen.mjs",
    "vectors": "cd ../.. && cargo run -p aegis-test-kit --example phase9_vectors_dump -- tests/vectors",
    "vectors:check": "cd ../.. && ./scripts/check-vectors.sh",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/vectors.test.ts test/pda.test.ts test/tx-size.test.ts",
    "test:e2e": "vitest run test/e2e.test.ts --testTimeout=120000"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.0",
    "@solana-program/compute-budget": "0.18.1",
    "@solana-program/system": "0.14.1",
    "@solana-program/token": "0.16.1",
    "@solana/kit": "8.3.0",
    "@solana/rpc-types": "8.3.0",
    "@solana/transactions": "8.3.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
